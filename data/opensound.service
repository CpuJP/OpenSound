[Unit]
Description=OpenSound daemon (headphones control over Bluetooth)
Documentation=https://github.com/CpuJP/OpenSound
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.cpujp.OpenSound
ExecStart=/usr/bin/opensound-daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
